---
// 长尾页内嵌的即时扫描岛：纯浏览器端启发式评分（零额度消耗）
// detect 页 → CTA 引导到完整检测器；humanize 页 → CTA 直达人性化（文本透传）
interface Props {
  tool: 'detect' | 'humanize';
}

const { tool } = Astro.props;
---

<div data-lt-scanner data-tool={tool} class="mt-6 rounded-2xl border border-zinc-200 bg-white p-5">
  <textarea
    class="lt-input w-full rounded-xl border border-zinc-300 p-3.5 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
    rows="6"
    placeholder="Paste your text here (40+ words for a meaningful score)…"></textarea>

  <div class="mt-3 flex flex-wrap items-center gap-3">
    <button class="lt-scan inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-4 py-2 text-sm font-semibold text-white hover:bg-zinc-700">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><line x1="7" x2="17" y1="12" y2="12"/></svg>
      <span>Scan text</span>
    </button>
    <span class="lt-words text-sm text-zinc-500"></span>
    <span class="lt-result hidden shrink-0"></span>
  </div>

  <a class="lt-cta mt-4 hidden w-fit items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-500" href="#">
    <span class="lt-cta-label"></span>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
  </a>

  <p class="mt-2 flex items-center gap-1.5 text-xs text-zinc-400">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    Runs locally in your browser — text never leaves this page.
  </p>
</div>

<script>
  import { heuristicDetector } from '../lib/detect/heuristic';

  const root = document.querySelector('[data-lt-scanner]');
  if (root) {
    const tool = root.getAttribute('data-tool') ?? 'detect';
    const input = root.querySelector('.lt-input') as HTMLTextAreaElement;
    const scanBtn = root.querySelector('.lt-scan') as HTMLButtonElement;
    const wordsEl = root.querySelector('.lt-words')!;
    const resultEl = root.querySelector('.lt-result')!;
    const cta = root.querySelector('.lt-cta') as HTMLAnchorElement;
    const ctaLabel = root.querySelector('.lt-cta-label')!;

    function updateCount() {
      const n = input.value.trim() ? input.value.trim().split(/\s+/).length : 0;
      wordsEl.textContent = n ? `${n} words` : '';
    }
    input.addEventListener('input', updateCount);

    scanBtn.addEventListener('click', async () => {
      const text = input.value.trim();
      const words = text ? text.split(/\s+/).length : 0;
      if (words < 40) {
        resultEl.textContent = `Need at least 40 words (got ${words}).`;
        resultEl.className = 'lt-result shrink-0 text-sm text-amber-600';
        return;
      }

      const label = scanBtn.querySelector('span')!;
      const old = label.textContent;
      label.textContent = 'Scanning…';
      scanBtn.setAttribute('disabled', '');

      const r = await heuristicDetector.detect(text);
      const pct = Math.round(r.score * 100);
      const verdict = r.score > 0.7 ? 'Likely AI' : r.score >= 0.4 ? 'Mixed' : 'Likely human';
      const tone = r.score > 0.7 ? 'bg-rose-50 text-rose-700' : r.score >= 0.4 ? 'bg-amber-50 text-amber-700' : 'bg-emerald-50 text-emerald-700';
      resultEl.innerHTML = `<span class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold ${tone}">${pct}% · ${verdict}</span>`;
      resultEl.className = 'lt-result shrink-0';

      // CTA：检测页引导看完整报告；人性化页直接带着文本去修
      if (tool === 'humanize') {
        cta.href = `/ai-humanizer?text=${encodeURIComponent(text)}`;
        ctaLabel.textContent = pct >= 40 ? 'Make it sound human' : 'Polish it anyway';
      } else {
        cta.href = `/ai-detector?text=${encodeURIComponent(text)}`;
        ctaLabel.textContent = 'See full sentence breakdown';
      }
      cta.classList.remove('hidden');
      cta.classList.add('flex');

      label.textContent = old;
      scanBtn.removeAttribute('disabled');
    });
  }
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Paraphrasing Tool — Rewrite Text in Fluent, Formal or Simple English"
  description="Paraphrase any English text in fluent, formal, or simple wording. Free, no signup, meaning preserved exactly — results in seconds."
>
  <div class="flex items-center gap-3">
    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-50 text-violet-600">
      <Icon name="refresh-cw" class="h-6 w-6" />
    </span>
    <h1 class="text-3xl font-extrabold tracking-tight">Paraphrasing Tool</h1>
  </div>
  <p class="mt-3 text-zinc-600 leading-relaxed">
    Paste text and get it rewritten in fluent, formal, or simple English. Free, no signup,
    and the meaning stays exactly the same — only the wording changes.
  </p>

  <div class="mt-6">
    <div>
      <span class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Style</span>
      <div class="mt-1.5 flex flex-wrap gap-1.5">
        <button data-style="fluent" class="style-chip rounded-lg border border-zinc-900 bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white">Fluent</button>
        <button data-style="formal" class="style-chip rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-800 hover:border-zinc-900">Formal</button>
        <button data-style="simple" class="style-chip rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-800 hover:border-zinc-900">Simple</button>
      </div>
    </div>

    <textarea
      id="input"
      rows="8"
      placeholder="Paste at least 20 words of text…"
      class="mt-4 w-full rounded-xl border border-zinc-300 p-4 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white"></textarea>

    <div class="mt-3 flex flex-wrap items-center gap-3">
      <button id="go" class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-zinc-700">
        <Icon name="refresh-cw" class="h-4 w-4" /><span>Paraphrase</span>
      </button>
      <span id="wordcount" class="text-sm text-zinc-500">0 words</span>
      <span id="quota" class="ml-auto text-sm text-zinc-500"></span>
    </div>
    <p id="error" class="mt-2 hidden text-sm text-rose-600"></p>

    <div id="resultbox" class="mt-4 hidden rounded-2xl border border-zinc-200 bg-white p-4">
      <div class="mb-2 flex items-center justify-between">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Paraphrased</h2>
        <button id="copy" class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-300 px-2.5 py-1.5 text-xs font-medium text-zinc-800 hover:border-zinc-900 bg-white">
          <Icon name="copy" class="h-3.5 w-3.5" /><span>Copy</span>
        </button>
      </div>
      <div id="out" class="font-mono text-sm whitespace-pre-wrap"></div>
    </div>
  </div>

  <section class="mt-10">
    <h2 class="text-xl font-bold">FAQ</h2>
    <div class="mt-3 space-y-4 text-zinc-800">
      <div>
        <h3 class="font-semibold">Which style should I pick?</h3>
        <p class="text-sm text-zinc-600">Fluent for everyday natural writing. Formal for business or academic contexts. Simple rewrites at an 8th-grade reading level — great for plain-language requirements.</p>
      </div>
      <div>
        <h3 class="font-semibold">Is paraphrasing the same as the AI Humanizer?</h3>
        <p class="text-sm text-zinc-600">No. This tool rewords text in a chosen style. The <a href="/ai-humanizer" class="text-emerald-700 underline">AI Humanizer</a> specifically removes AI-writing patterns and shows the AI score dropping.</p>
      </div>
    </div>
  </section>

  <p class="mt-8 text-sm text-zinc-500">
    Also try the <a href="/text-summarizer" class="text-emerald-700 underline">text summarizer</a> or
    <a href="/word-counter" class="text-emerald-700 underline">word counter</a>.
  </p>
</BaseLayout>

<script>
  const input = document.getElementById('input') as HTMLTextAreaElement;
  const goBtn = document.getElementById('go')!;
  const wordcount = document.getElementById('wordcount')!;
  const quota = document.getElementById('quota')!;
  const errorEl = document.getElementById('error')!;

  let style = 'fluent';

  document.querySelectorAll<HTMLButtonElement>('.style-chip').forEach((b) => {
    b.addEventListener('click', () => {
      style = b.dataset.style!;
      document.querySelectorAll('.style-chip').forEach((x) => {
        x.className = 'style-chip rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-800 hover:border-zinc-900';
      });
      b.className = 'style-chip rounded-lg border border-zinc-900 bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white';
    });
  });

  function updateCount() {
    const n = input.value.trim() ? input.value.trim().split(/\s+/).length : 0;
    wordcount.textContent = `${n} words${n > 0 && n < 20 ? ` (${20 - n} more needed)` : n > 500 ? ' (over 500-word limit)' : ''}`;
  }
  input.addEventListener('input', updateCount);
  updateCount();

  goBtn.addEventListener('click', async () => {
    errorEl.classList.add('hidden');
    const label = goBtn.querySelector('span')!;
    const old = label.textContent;
    label.textContent = 'Paraphrasing…';
    goBtn.setAttribute('disabled', '');
    try {
      const res = await fetch('/api/paraphrase', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: input.value, style }),
      });
      const data = await res.json();
      if (!res.ok) {
        errorEl.textContent = data?.error?.message ?? 'Something went wrong.';
        errorEl.classList.remove('hidden');
        return;
      }
      document.getElementById('out')!.textContent = data.result;
      quota.textContent = `${data.remaining} of 5 free rewrites left today`;
      document.getElementById('resultbox')!.classList.remove('hidden');
    } catch {
      errorEl.textContent = 'Network error — please try again.';
      errorEl.classList.remove('hidden');
    } finally {
      label.textContent = old;
      goBtn.removeAttribute('disabled');
    }
  });

  document.getElementById('copy')!.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    await navigator.clipboard.writeText(document.getElementById('out')!.textContent ?? '');
    const label = btn.querySelector('span')!;
    label.textContent = 'Copied!';
    setTimeout(() => (label.textContent = 'Copy'), 1200);
  });
</script>

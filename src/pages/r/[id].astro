---
// /r/[id] —— 只读检测结果分享页（服务端渲染，PRD §4.1）
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getRuntimeEnv, getShare } from '../../lib/store';

export const prerender = false;

const { id } = Astro.params;
const record = id ? await getShare(getRuntimeEnv(Astro.locals), id) : null;

const FLAG_STYLE: Record<string, string> = {
  high: 'bg-rose-50 border-l-2 border-rose-400 text-rose-900',
  mid: 'bg-amber-50 border-l-2 border-amber-400 text-amber-900',
  low: 'bg-emerald-50 border-l-2 border-emerald-400 text-emerald-900',
};

const VERDICT: Record<string, { text: string; cls: string; ring: string }> = {
  ai: { text: 'Likely AI-generated', cls: 'text-rose-600', ring: '#e11d48' },
  mixed: { text: 'Mixed signals', cls: 'text-amber-600', ring: '#d97706' },
  human: { text: 'Likely human-written', cls: 'text-emerald-600', ring: '#059669' },
};
---

<BaseLayout
  title={record ? `AI Report — ${Math.round(record.score * 100)}% AI score` : 'Report not found'}
  description={record ? `Shared AI detection report: ${Math.round(record.score * 100)}% AI probability across ${record.words} words.` : 'This detection report has expired or does not exist.'}
>
  {!record ? (
    <div class="text-center py-16">
      <h1 class="text-2xl font-bold">Report not found</h1>
      <p class="mt-2 text-zinc-600 text-sm">This share link has expired (reports are kept for 7 days).</p>
      <a href="/ai-detector" class="mt-6 inline-flex items-center gap-1.5 rounded-lg bg-zinc-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-zinc-700">
        Run your own check <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  ) : (
    <div>
      <h1 class="text-2xl font-extrabold tracking-tight">AI Detection Report</h1>

      <div class="mt-6 rounded-2xl border border-zinc-200 bg-white p-6">
        <div class="flex flex-col sm:flex-row items-center gap-6">
          <div class="relative h-28 w-28 shrink-0">
            <svg viewBox="0 0 120 120" class="h-28 w-28 -rotate-90">
              <circle cx="60" cy="60" r="52" fill="none" stroke="#e4e4e7" stroke-width="10" />
              <circle cx="60" cy="60" r="52" fill="none" stroke={VERDICT[record.label]?.ring ?? '#e11d48'} stroke-width="10" stroke-linecap="round" stroke-dasharray="326.7" stroke-dashoffset={String(326.7 * (1 - record.score))} />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span class="text-2xl font-extrabold">{Math.round(record.score * 100)}%</span>
              <span class="text-[9px] text-zinc-500 uppercase tracking-wide">AI score</span>
            </div>
          </div>
          <div class="text-center sm:text-left">
            <h2 class={`text-xl font-bold ${VERDICT[record.label]?.cls ?? ''}`}>{VERDICT[record.label]?.text ?? 'Report'}</h2>
            <p class="mt-1 text-sm text-zinc-500">{record.words} words · {record.sentences.length} sentences</p>
            <a href="/ai-detector" class="mt-3 inline-flex items-center gap-1.5 rounded-lg bg-zinc-900 px-3 py-2 text-sm font-semibold text-white hover:bg-zinc-700">
              Check your own text <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </div>

      <div class="mt-4 rounded-2xl border border-zinc-200 bg-white p-6">
        <h2 class="font-bold">Sentence breakdown</h2>
        <p class="text-xs text-zinc-500 mt-0.5">Red = likely AI · Amber = mixed · Green = likely human</p>
        <div class="mt-4 space-y-2 text-sm leading-relaxed">
          {record.sentences.map((s) => (
            <p class={`rounded-r-lg px-3 py-2 ${FLAG_STYLE[s.flag] ?? ''}`}>{s.text}</p>
          ))}
        </div>
      </div>

      <p class="mt-6 text-xs text-zinc-400">
        Scores are a probability estimate, not proof. Generated with the free AI Detector at TextKit.
      </p>
    </div>
  )}
</BaseLayout>

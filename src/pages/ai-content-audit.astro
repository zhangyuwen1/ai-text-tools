---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="AI Content Audit — Check Any URL for AI Content & SEO Risk"
  description="Paste a URL to audit any article or blog post for AI content, SEO risk, sentence rhythm, vocabulary quality, and structure. Free, instant report."
>
  <div class="flex items-center gap-3">
    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
      <Icon name="shield-check" class="h-6 w-6" />
    </span>
    <h1 class="text-3xl font-extrabold tracking-tight">AI Content Audit</h1>
  </div>
  <p class="mt-3 text-zinc-600 leading-relaxed max-w-xl">
    Paste any article URL to get a full content quality report: AI probability, sentence rhythm,
    vocabulary health, structure quality, and SEO risk — with specific issues and fixes.
    Free, no signup.
  </p>

  <div class="mt-6">
    <div class="flex gap-2">
      <input
        id="url"
        type="url"
        placeholder="https://example.com/blog/your-article"
        class="w-full rounded-xl border border-zinc-300 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white" />
      <button id="go" class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-zinc-900 px-6 py-3 text-sm font-semibold text-white hover:bg-zinc-700">
        <Icon name="shield-check" class="h-4 w-4" /><span>Audit</span>
      </button>
    </div>
    <p id="quota" class="mt-2 text-sm text-zinc-500"></p>
    <p id="error" class="mt-2 hidden text-sm text-rose-600"></p>
  </div>

  <!-- 报告区 -->
  <div id="report" class="mt-8 hidden space-y-4">
    <!-- 综合风险卡 -->
    <div class="rounded-2xl border border-zinc-200 bg-white p-6">
      <div class="flex flex-col sm:flex-row items-center gap-6">
        <div class="relative h-28 w-28 shrink-0">
          <svg viewBox="0 0 120 120" class="h-28 w-28 -rotate-90">
            <circle cx="60" cy="60" r="52" fill="none" stroke="#e4e4e7" stroke-width="10" />
            <circle id="ring" cx="60" cy="60" r="52" fill="none" stroke="#e11d48" stroke-width="10" stroke-linecap="round" stroke-dasharray="326.7" stroke-dashoffset="326.7" />
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span id="risk-score" class="text-2xl font-extrabold">–</span>
            <span class="text-[9px] text-zinc-500 uppercase tracking-wide">Risk</span>
          </div>
        </div>
        <div class="text-center sm:text-left">
          <h2 id="risk-label" class="text-xl font-bold">–</h2>
          <p id="meta" class="mt-1 text-sm text-zinc-500"></p>
          <p id="url-display" class="mt-1 text-xs text-zinc-400 truncate max-w-md"></p>
        </div>
      </div>
    </div>

    <!-- 六维雷达 -->
    <div class="rounded-2xl border border-zinc-200 bg-white p-6">
      <h2 class="font-bold">Content Scores</h2>
      <div id="scores" class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-3 text-center"></div>
    </div>

    <!-- 问题列表 -->
    <div class="rounded-2xl border border-zinc-200 bg-white p-6">
      <h2 class="font-bold">Issues Found</h2>
      <div id="issues" class="mt-4 space-y-3"></div>
    </div>

    <!-- 统计亮点 -->
    <div class="rounded-2xl border border-zinc-200 bg-white p-6">
      <h2 class="font-bold">Content Stats</h2>
      <div id="stats" class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-3 text-center"></div>
    </div>

    <!-- CTA -->
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 text-center">
      <p class="text-sm text-emerald-700">Need to fix flagged content? Run it through the AI Humanizer.</p>
      <a href="/ai-humanizer" class="mt-3 inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-500">
        Fix it with AI Humanizer <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>

  <section class="mt-10">
    <h2 class="text-xl font-bold">FAQ</h2>
    <div class="mt-3 space-y-4 text-zinc-800">
      <div>
        <h3 class="font-semibold">What does the audit check?</h3>
        <p class="text-sm text-zinc-600">Six dimensions: AI probability, sentence rhythm (burstiness), AI vocabulary density, content structure, readability (Flesch), and an overall SEO risk score.</p>
      </div>
      <div>
        <h3 class="font-semibold">Who is this for?</h3>
        <p class="text-sm text-zinc-600">SEO agencies, content marketers, and blog owners who buy or publish articles and need to verify quality before they go live.</p>
      </div>
      <div>
        <h3 class="font-semibold">How many free audits do I get?</h3>
        <p class="text-sm text-zinc-600">1 per day without an account, 2 with a free account, and 20 per day with Pro.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const urlInput = document.getElementById('url') as HTMLInputElement;
  const goBtn = document.getElementById('go')!;
  const quotaEl = document.getElementById('quota')!;
  const errorEl = document.getElementById('error')!;
  const reportEl = document.getElementById('report')!;

  // URL 预填（/ai-content-audit?url=...）
  const prefill = new URLSearchParams(location.search).get('url');
  if (prefill) urlInput.value = prefill;

  goBtn.addEventListener('click', async () => {
    errorEl.classList.add('hidden');
    reportEl.classList.add('hidden');
    const url = urlInput.value.trim();
    if (!url) return;

    const label = goBtn.querySelector('span')!;
    const old = label.textContent;
    label.textContent = 'Auditing…';
    goBtn.setAttribute('disabled', '');

    try {
      const res = await fetch('/api/audit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url }),
      });
      const data = await res.json();

      if (!res.ok) {
        errorEl.textContent = data?.error?.message ?? 'Something went wrong.';
        errorEl.classList.remove('hidden');
        return;
      }

      renderReport(data.report, data.remaining, data.tier);
    } catch {
      errorEl.textContent = 'Network error — please try again.';
      errorEl.classList.remove('hidden');
    } finally {
      label.textContent = old;
      goBtn.removeAttribute('disabled');
    }
  });

  function scoreColor(v: number): string {
    return v >= 70 ? 'text-emerald-600' : v >= 40 ? 'text-amber-600' : 'text-rose-600';
  }

  function renderReport(r: any, remaining: number, tier: string) {
    quotaEl.textContent = tier === 'pro' ? 'Pro — 20 audits/day' : `${remaining} audit${remaining === 1 ? '' : 's'} left today`;

    // 综合风险
    const ring = document.getElementById('ring')!;
    ring.style.strokeDashoffset = String(326.7 * (1 - r.scores.overallRisk / 100));
    ring.setAttribute('stroke', r.scores.overallRisk >= 75 ? '#e11d48' : r.scores.overallRisk >= 55 ? '#ea580c' : r.scores.overallRisk >= 35 ? '#d97706' : '#059669');
    document.getElementById('risk-score')!.textContent = `${r.scores.overallRisk}`;

    const labels: Record<string, string> = { low: 'Low Risk', medium: 'Medium Risk', high: 'High Risk', critical: 'Critical Risk' };
    const labelEl = document.getElementById('risk-label')!;
    labelEl.textContent = labels[r.riskLabel] ?? 'Report';
    labelEl.className = `text-xl font-bold ${r.riskLabel === 'low' ? 'text-emerald-600' : r.riskLabel === 'medium' ? 'text-amber-600' : 'text-rose-600'}`;

    document.getElementById('meta')!.textContent = `${r.wordCount} words · ${r.title}`;
    document.getElementById('url-display')!.textContent = r.url;

    // 六维评分
    const scores = [
      { label: 'AI Probability', v: r.scores.aiProbability, invert: true },
      { label: 'Sentence Rhythm', v: r.scores.sentenceRhythm, invert: false },
      { label: 'Vocabulary Health', v: r.scores.vocabularyHealth, invert: false },
      { label: 'Structure Quality', v: r.scores.structureQuality, invert: false },
      { label: 'Readability', v: r.scores.readability, invert: false },
      { label: 'Overall Risk', v: r.scores.overallRisk, invert: true },
    ];
    document.getElementById('scores')!.innerHTML = scores.map((s) => {
      const good = s.invert ? s.v < 40 : s.v >= 60;
      const mid = s.invert ? s.v < 70 : s.v >= 40;
      const color = good ? 'text-emerald-600' : mid ? 'text-amber-600' : 'text-rose-600';
      return `<div class="rounded-xl border border-zinc-200 bg-white p-3"><div class="text-2xl font-bold ${color}">${s.v}</div><div class="text-xs text-zinc-500 mt-1">${s.label}</div></div>`;
    }).join('');

    // 问题列表
    const sevColor: Record<string, string> = { high: 'border-rose-400 bg-rose-50', medium: 'border-amber-400 bg-amber-50', low: 'border-emerald-400 bg-emerald-50' };
    const sevIcon: Record<string, string> = { high: '🔴', medium: '🟡', low: '🟢' };
    document.getElementById('issues')!.innerHTML = r.issues.map((i: any) => `
      <div class="rounded-r-lg border-l-4 px-4 py-3 ${sevColor[i.severity] ?? ''}">
        <div class="flex items-center gap-2 font-semibold text-sm">${sevIcon[i.severity] ?? '⚪'} ${i.title}</div>
        <p class="mt-1 text-sm text-zinc-700">${i.detail}</p>
        <p class="mt-1 text-xs text-zinc-500"><strong>Fix:</strong> ${i.fix}</p>
      </div>
    `).join('');

    // 统计
    const stats = [
      { label: 'Avg Sentence Length', v: `${r.highlights.avgSentenceLength} words` },
      { label: 'Sentence Variance', v: r.highlights.sentenceLengthVariance.toFixed(2) },
      { label: 'Flesch Score', v: r.highlights.fleschScore },
      { label: 'Paragraphs', v: r.highlights.paragraphCount },
    ];
    document.getElementById('stats')!.innerHTML = stats.map((s) =>
      `<div class="rounded-xl border border-zinc-200 bg-white p-3"><div class="text-lg font-bold text-zinc-800">${s.v}</div><div class="text-xs text-zinc-500 mt-1">${s.label}</div></div>`
    ).join('');

    reportEl.classList.remove('hidden');
    reportEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
</script>

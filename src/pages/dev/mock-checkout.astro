---
// 模拟结账页（仅 mock 支付模式使用；切真实 MoR 后此页不再被引用）
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
---

<BaseLayout
  title="Checkout (Simulated) — TextKit AI Pro"
  description="Simulated checkout for development."
>
  <div class="mx-auto max-w-md">
    <div class="rounded-2xl border-2 border-dashed border-amber-300 bg-amber-50 p-3 text-center text-xs font-medium text-amber-700">
      ⚠ Simulated payment — dev mode only. No real charge.
    </div>

    <div class="mt-4 rounded-2xl border border-zinc-200 bg-white p-6">
      <h1 class="text-xl font-extrabold">TextKit AI Pro</h1>
      <p class="mt-1 text-sm text-zinc-500" id="plan-line">…</p>

      <div class="mt-5 space-y-3 text-sm">
        <div class="flex justify-between"><span class="text-zinc-500">Card number</span><span class="font-mono">4242 4242 4242 4242</span></div>
        <div class="flex justify-between"><span class="text-zinc-500">Expiry</span><span class="font-mono">12 / 28</span></div>
        <div class="flex justify-between border-t border-zinc-100 pt-3 text-base font-bold"><span>Total</span><span id="amount">—</span></div>
      </div>

      <button id="pay" class="mt-6 w-full rounded-lg bg-emerald-600 px-4 py-3 text-sm font-semibold text-white hover:bg-emerald-500">
        Pay (Simulated)
      </button>
      <p id="status" class="mt-3 hidden text-center text-sm"></p>
    </div>
  </div>
</BaseLayout>

<script>
  const params = new URLSearchParams(location.search);
  const plan = params.get('plan') === 'yearly' ? 'yearly' : 'monthly';
  const userId = params.get('userId') ?? '';

  document.getElementById('plan-line')!.textContent =
    plan === 'yearly' ? 'Annual — $39.00 per year' : 'Monthly — $4.99 per month';
  document.getElementById('amount')!.textContent = plan === 'yearly' ? '$39.00' : '$4.99';

  const payBtn = document.getElementById('pay')!;
  const status = document.getElementById('status')!;
  payBtn.addEventListener('click', async () => {
    payBtn.setAttribute('disabled', '');
    status.textContent = 'Processing…';
    status.classList.remove('hidden');

    const res = await fetch('/api/payments/webhook', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        type: 'subscription.active',
        userId,
        plan,
        subId: 'mock_' + Math.random().toString(36).slice(2, 10),
        currentPeriodEnd: Math.floor(Date.now() / 1000) + (plan === 'yearly' ? 365 : 30) * 86400,
      }),
    });

    if (res.ok) {
      status.innerHTML = '✅ Payment complete — <a href="/account" class="text-emerald-700 underline">go to your account</a>';
    } else {
      status.textContent = 'Failed: ' + (await res.text());
      payBtn.removeAttribute('disabled');
    }
  });
</script>

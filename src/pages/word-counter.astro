---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Word Counter — Count Words, Characters & Reading Time Free"
  description="Paste any text to count words, characters, sentences, paragraphs, reading time, and keyword density instantly. Free, no signup — your text never leaves your browser."
>
  <div class="flex items-center gap-3">
    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
      <Icon name="align-left" class="h-6 w-6" />
    </span>
    <h1 class="text-3xl font-extrabold tracking-tight">Word Counter</h1>
  </div>
  <p class="mt-3 text-zinc-600 leading-relaxed">
    Paste or type your text below to count words, characters, sentences, and reading time
    instantly. Free, no signup, and your text never leaves your browser. Works great for
    essays, blog posts, tweets, and SEO content.
  </p>

  <div class="mt-6">
    <textarea
      id="input"
      rows="10"
      placeholder="Paste your text here…"
      class="w-full rounded-xl border border-zinc-300 p-4 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white"></textarea>

    <div id="stats" class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-3 text-center"></div>

    <div id="keywords" class="mt-4 hidden rounded-xl border border-zinc-200 bg-white p-4">
      <h2 class="font-bold text-sm mb-2">Top keywords (3+ letters)</h2>
      <div id="keyword-list" class="flex flex-wrap gap-2 text-sm"></div>
    </div>
  </div>

  <section class="mt-10">
    <h2 class="text-xl font-bold">FAQ</h2>
    <div class="mt-3 space-y-4 text-zinc-800">
      <div>
        <h3 class="font-semibold">How many words is a 5-minute speech?</h3>
        <p class="text-sm text-zinc-600">At an average speaking pace of 130 words per minute, a 5-minute speech is about 650 words.</p>
      </div>
      <div>
        <h3 class="font-semibold">How is reading time calculated?</h3>
        <p class="text-sm text-zinc-600">We use 200 words per minute, the average adult silent reading speed. A 1,000-word article takes about 5 minutes.</p>
      </div>
      <div>
        <h3 class="font-semibold">Is my text uploaded anywhere?</h3>
        <p class="text-sm text-zinc-600">No. Counting happens entirely in your browser with JavaScript — nothing is sent to any server.</p>
      </div>
    </div>
  </section>

  <p class="mt-8 text-sm text-zinc-500">
    Next: <a href="/case-converter" class="text-emerald-700 underline">convert your text to any letter case</a>,
    or <a href="/remove-line-breaks" class="text-emerald-700 underline">clean up line breaks</a>.
  </p>
</BaseLayout>

<script>
  const input = document.getElementById('input') as HTMLTextAreaElement;
  const stats = document.getElementById('stats')!;
  const keywordsBox = document.getElementById('keywords')!;
  const keywordList = document.getElementById('keyword-list')!;

  const STOPWORDS = new Set(('the,and,for,are,but,not,you,your,with,that,this,have,from,was,were,they,their,them,has,had,will,would,can,could,should,what,when,where,which,while,about,into,over,than,then,them,more,most,some,such,only,also,just,been,being,does,doing,it\'s,its,all,any,each,how,who,why,our,out,own,same,she,he,him,her,his,was,were,very,too,two,one,use,used,using').split(','));

  function stat(label: string, value: string) {
    return `<div class="rounded-xl border border-zinc-200 bg-white p-3"><div class="text-2xl font-bold text-emerald-700">${value}</div><div class="text-xs text-zinc-500 mt-1">${label}</div></div>`;
  }

  function update() {
    const text = input.value;
    const trimmed = text.trim();
    const words = trimmed ? trimmed.split(/\s+/).length : 0;
    const chars = text.length;
    const charsNoSpaces = text.replace(/\s/g, '').length;
    const sentences = trimmed ? (trimmed.match(/[.!?]+(?:\s|$)/g) || []).length || 1 : 0;
    const paragraphs = trimmed ? trimmed.split(/\n\s*\n/).filter((p) => p.trim()).length : 0;
    const readingMin = words / 200;
    const reading = words === 0 ? '0m' : readingMin < 1 ? '<1 min' : `${Math.ceil(readingMin)} min`;

    stats.innerHTML =
      stat('Words', String(words)) +
      stat('Characters', chars.toLocaleString()) +
      stat('Chars (no spaces)', charsNoSpaces.toLocaleString()) +
      stat('Sentences', String(sentences)) +
      stat('Paragraphs', String(paragraphs)) +
      stat('Reading time', reading);

    if (words > 10) {
      const freq = new Map<string, number>();
      for (const raw of trimmed.toLowerCase().split(/[^a-z']+/)) {
        const w = raw.replace(/^'+|'+$/g, '');
        if (w.length >= 3 && !STOPWORDS.has(w)) freq.set(w, (freq.get(w) || 0) + 1);
      }
      const top = [...freq.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);
      if (top.length) {
        keywordsBox.classList.remove('hidden');
        keywordList.innerHTML = top
          .map(([w, n]) => `<span class="rounded-full bg-emerald-50 text-emerald-700 px-3 py-1">${w} · ${n} (${((n / words) * 100).toFixed(1)}%)</span>`)
          .join('');
      }
    } else {
      keywordsBox.classList.add('hidden');
    }
  }

  input.addEventListener('input', update);
  update();
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="AI Humanizer — Make AI Text Sound Human (Coming Soon)"
  description="Rewrite AI-generated text so it reads naturally: varied rhythm, no AI clichés, meaning fully preserved. Free tier planned with instant browser results."
>
  <div class="flex items-center gap-3">
    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
      <Icon name="sparkles" class="h-6 w-6" />
    </span>
    <h1 class="text-3xl font-extrabold tracking-tight">AI Humanizer</h1>
  </div>
  <p class="mt-3 text-zinc-600 leading-relaxed">
    Paste AI-generated text and get a version that reads like a person wrote it — varied
    sentence rhythm, zero AI clichés, all facts kept intact. Launching soon.
  </p>

  <div class="mt-8 rounded-2xl border border-dashed border-zinc-300 bg-white p-8 text-center">
    <Icon name="sparkles" class="h-8 w-8 mx-auto text-emerald-500" />
    <h2 class="mt-3 font-bold text-lg text-zinc-500">Under construction</h2>
    <p class="mt-1 text-sm text-zinc-400">The humanizer ships right after the AI Detector. In the meantime:</p>
    <div class="mt-5 flex flex-wrap justify-center gap-2">
      <a href="/ai-detector" class="inline-flex items-center gap-1.5 rounded-lg bg-zinc-900 px-3 py-2 text-sm font-semibold text-white hover:bg-zinc-700">
        Try the AI Detector <Icon name="arrow-right" class="h-4 w-4" />
      </a>
      <a href="/word-counter" class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-300 px-3 py-2 text-sm font-medium text-zinc-800 hover:border-zinc-900 bg-white">
        Word Counter
      </a>
    </div>
  </div>
</BaseLayout>

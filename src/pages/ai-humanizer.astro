---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="AI Humanizer — Make AI Text Sound Human, Free"
  description="Rewrite AI-generated text so it reads like a person wrote it: varied rhythm, no AI clichés, all facts kept intact. Free, no signup, with before/after AI score comparison."
>
  <div class="flex items-center gap-3">
    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
      <Icon name="sparkles" class="h-6 w-6" />
    </span>
    <h1 class="text-3xl font-extrabold tracking-tight">AI Humanizer</h1>
  </div>
  <p class="mt-3 text-zinc-600 leading-relaxed">
    Paste AI-generated text and get a version that reads like a human wrote it — varied
    sentence rhythm, zero AI clichés, every fact kept intact. Free, no signup, and you'll
    see the AI score drop before your eyes.
  </p>

  <div class="mt-6">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Mode</span>
        <div id="modes" class="mt-1.5 flex flex-wrap gap-1.5">
          <button data-mode="standard" class="mode-chip rounded-lg border border-zinc-900 bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white">Standard</button>
          <button data-mode="academic" class="mode-chip rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-800 hover:border-zinc-900">Academic</button>
          <button data-mode="casual" class="mode-chip rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-800 hover:border-zinc-900">Casual</button>
          <button data-mode="creative" class="mode-chip rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-800 hover:border-zinc-900">Creative</button>
        </div>
      </div>
      <div>
        <span class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Strength</span>
        <div id="strengths" class="mt-1.5 flex flex-wrap gap-1.5">
          <button data-strength="light" class="str-chip rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-800 hover:border-zinc-900">Light</button>
          <button data-strength="balanced" class="str-chip rounded-lg border border-zinc-900 bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white">Balanced</button>
          <button data-strength="strong" class="str-chip rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-800 hover:border-zinc-900">Strong</button>
        </div>
      </div>
    </div>

    <textarea
      id="input"
      rows="9"
      placeholder="Paste at least 50 words of AI-generated text…"
      class="mt-4 w-full rounded-xl border border-zinc-300 p-4 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white"></textarea>

    <div class="mt-3 flex flex-wrap items-center gap-3">
      <button id="go" class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-zinc-700">
        <Icon name="sparkles" class="h-4 w-4" /><span>Humanize text</span>
      </button>
      <span id="wordcount" class="text-sm text-zinc-500">0 words</span>
      <span id="quota" class="ml-auto text-sm text-zinc-500"></span>
      <a href="/pricing" class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 hover:bg-emerald-100">Get Pro →</a>
    </div>
    <p id="error" class="mt-2 hidden text-sm text-rose-600"></p>
  </div>

  <!-- 结果区：闭环分数 + 对比视图 -->
  <div id="result" class="mt-8 hidden">
    <div class="rounded-2xl border border-zinc-200 bg-white p-6">
      <div class="flex flex-wrap items-center justify-center gap-3 text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-rose-50 px-4 py-2">
          <span class="text-xs font-medium text-rose-600 uppercase tracking-wide">Before</span>
          <span id="before" class="text-xl font-extrabold text-rose-600">–</span>
        </span>
        <Icon name="arrow-right" class="h-5 w-5 text-zinc-400" />
        <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-4 py-2">
          <span class="text-xs font-medium text-emerald-600 uppercase tracking-wide">After</span>
          <span id="after" class="text-xl font-extrabold text-emerald-600">–</span>
        </span>
        <span id="delta" class="text-sm text-zinc-500"></span>
      </div>
      <p class="mt-2 text-center text-xs text-zinc-400">AI probability score, re-checked automatically after rewriting</p>
    </div>

    <div class="mt-4 grid gap-4 lg:grid-cols-2">
      <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-4">
        <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-zinc-500">Original</h2>
        <div id="orig" class="font-mono text-sm text-zinc-600 whitespace-pre-wrap"></div>
      </div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-4">
        <div class="mb-2 flex items-center justify-between">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Humanized</h2>
          <button id="copy" class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-300 px-2.5 py-1.5 text-xs font-medium text-zinc-800 hover:border-zinc-900 bg-white">
            <Icon name="copy" class="h-3.5 w-3.5" /><span>Copy</span>
          </button>
        </div>
        <div id="out" class="font-mono text-sm whitespace-pre-wrap"></div>
      </div>
    </div>

    <p class="mt-3 text-center text-sm text-zinc-500">
      Want sentence-level details? <a id="recheck" href="/ai-detector" class="text-emerald-700 underline">Re-check on the AI Detector →</a>
    </p>
  </div>

  <section class="mt-10">
    <h2 class="text-xl font-bold">FAQ</h2>
    <div class="mt-3 space-y-4 text-zinc-800">
      <div>
        <h3 class="font-semibold">Will the rewritten text keep my facts?</h3>
        <p class="text-sm text-zinc-600">Yes — the rewrite preserves every fact, number, and name. It changes rhythm and wording, never meaning. Still, give important output a quick read before using it.</p>
      </div>
      <div>
        <h3 class="font-semibold">What are the modes for?</h3>
        <p class="text-sm text-zinc-600">Standard fits most writing. Academic keeps a scholarly tone for papers. Casual sounds like a chat or post. Creative rewrites most freely.</p>
      </div>
      <div>
        <h3 class="font-semibold">Is my text stored?</h3>
        <p class="text-sm text-zinc-600">No. Text is processed in the moment and discarded — nothing is saved, logged, or shared.</p>
      </div>
    </div>
  </section>

  <p class="mt-8 text-sm text-zinc-500">
    Check text first with the <a href="/ai-detector" class="text-emerald-700 underline">AI Detector</a>, then humanize what gets flagged.
  </p>
</BaseLayout>

<script>
  const input = document.getElementById('input') as HTMLTextAreaElement;
  const goBtn = document.getElementById('go')!;
  const wordcount = document.getElementById('wordcount')!;
  const quota = document.getElementById('quota')!;
  const errorEl = document.getElementById('error')!;
  const resultEl = document.getElementById('result')!;

  let mode = 'standard';
  let strength = 'balanced';

  // 检测器跳转预填（闭环：/ai-humanizer?text=...）
  const prefill = new URLSearchParams(location.search).get('text');
  if (prefill) input.value = prefill;

  document.querySelectorAll<HTMLButtonElement>('.mode-chip').forEach((b) => {
    b.addEventListener('click', () => {
      mode = b.dataset.mode!;
      document.querySelectorAll('.mode-chip').forEach((x) => {
        x.className = 'mode-chip rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-800 hover:border-zinc-900';
      });
      b.className = 'mode-chip rounded-lg border border-zinc-900 bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white';
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.str-chip').forEach((b) => {
    b.addEventListener('click', () => {
      strength = b.dataset.strength!;
      document.querySelectorAll('.str-chip').forEach((x) => {
        x.className = 'str-chip rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-800 hover:border-zinc-900';
      });
      b.className = 'str-chip rounded-lg border border-zinc-900 bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white';
    });
  });

  function updateCount() {
    const n = input.value.trim() ? input.value.trim().split(/\s+/).length : 0;
    wordcount.textContent = `${n} words${n > 0 && n < 50 ? ` (${50 - n} more needed)` : n > 300 ? ' (over 300-word free limit)' : ''}`;
  }
  input.addEventListener('input', updateCount);
  updateCount();

  goBtn.addEventListener('click', async () => {
    errorEl.classList.add('hidden');
    const label = goBtn.querySelector('span')!;
    const old = label.textContent;
    label.textContent = 'Humanizing…';
    goBtn.setAttribute('disabled', '');

    try {
      const res = await fetch('/api/humanize', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: input.value, mode, strength }),
      });
      const data = await res.json();

      if (!res.ok) {
        errorEl.textContent = data?.error?.message ?? 'Something went wrong.';
        errorEl.classList.remove('hidden');
        return;
      }

      document.getElementById('before')!.textContent = `${Math.round(data.beforeScore * 100)}%`;
      document.getElementById('after')!.textContent = `${Math.round(data.afterScore * 100)}%`;
      const drop = Math.round((data.beforeScore - data.afterScore) * 100);
      document.getElementById('delta')!.textContent = drop > 0 ? `↓ ${drop} points` : '';
      document.getElementById('orig')!.textContent = input.value.trim();
      document.getElementById('out')!.textContent = data.result;
      quota.textContent = `${data.remaining} of 3 free rewrites left today`;

      const recheck = document.getElementById('recheck') as HTMLAnchorElement;
      recheck.href = `/ai-detector?text=${encodeURIComponent(data.result)}`;

      resultEl.classList.remove('hidden');
      resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch {
      errorEl.textContent = 'Network error — please try again.';
      errorEl.classList.remove('hidden');
    } finally {
      label.textContent = old;
      goBtn.removeAttribute('disabled');
    }
  });

  document.getElementById('copy')!.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    await navigator.clipboard.writeText(document.getElementById('out')!.textContent ?? '');
    const label = btn.querySelector('span')!;
    label.textContent = 'Copied!';
    setTimeout(() => (label.textContent = 'Copy'), 1200);
  });
</script>

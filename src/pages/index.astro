---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const tools = [
  {
    href: '/ai-detector',
    title: 'AI Detector',
    desc: 'Check how likely any text was written by AI — sentence-by-sentence highlighting, shareable report.',
    icon: 'scan',
    chip: 'bg-rose-50 text-rose-600',
  },
  {
    href: '/ai-humanizer',
    title: 'AI Humanizer',
    desc: 'Rewrite AI text so it reads genuinely human — varied rhythm, no clichés, facts intact.',
    icon: 'sparkles',
    chip: 'bg-emerald-50 text-emerald-600',
  },
  {
    href: '/paraphrasing-tool',
    title: 'Paraphrasing Tool',
    desc: 'Rewrite text in fluent, formal, or simple English — meaning preserved exactly.',
    icon: 'refresh-cw',
    chip: 'bg-violet-50 text-violet-600',
  },
  {
    href: '/text-summarizer',
    title: 'Text Summarizer',
    desc: 'Condense any article or email into a summary that keeps every key fact.',
    icon: 'file-text',
    chip: 'bg-sky-50 text-sky-600',
  },
  {
    href: '/word-counter',
    title: 'Word Counter',
    desc: 'Count words, characters, sentences, paragraphs, reading time, and keyword density.',
    icon: 'align-left',
    chip: 'bg-emerald-50 text-emerald-600',
  },
  {
    href: '/case-converter',
    title: 'Case Converter',
    desc: 'Convert to UPPERCASE, lowercase, Title Case, Sentence case, camelCase, snake_case, or kebab-case.',
    icon: 'type',
    chip: 'bg-violet-50 text-violet-600',
  },
  {
    href: '/remove-line-breaks',
    title: 'Remove Line Breaks',
    desc: 'Strip all newlines, delete blank lines, or replace line breaks with spaces in one click.',
    icon: 'wrap-text',
    chip: 'bg-amber-50 text-amber-600',
  },
  {
    href: '/text-sorter',
    title: 'Text Sorter',
    desc: 'Sort lines A–Z or by length, remove duplicates, trim whitespace, and drop empty lines.',
    icon: 'arrow-down-up',
    chip: 'bg-sky-50 text-sky-600',
  },
];
---

<BaseLayout
  title="TextKit — Free Online Text Tools, No Signup"
  description="Free online text tools that work instantly in your browser: word counter, case converter, line break remover, and text sorter. No signup, no uploads, no limits."
>
  <section>
    <h1 class="text-3xl font-extrabold tracking-tight">Free Online Text Tools</h1>
    <p class="mt-3 text-zinc-600 leading-relaxed max-w-xl">
      Paste your text and get results instantly — count words, convert letter case, clean up
      line breaks, or sort lists. Every tool runs entirely in your browser.
    </p>

    <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-zinc-600">
      <span class="inline-flex items-center gap-1.5"><Icon name="zap" class="h-4 w-4 text-emerald-600" /> Instant results</span>
      <span class="inline-flex items-center gap-1.5"><Icon name="lock" class="h-4 w-4 text-emerald-600" /> Private — text never leaves your browser</span>
      <span class="inline-flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-emerald-600" /> Free, no signup</span>
    </div>
  </section>

  <section id="tools" class="mt-8 grid gap-4 sm:grid-cols-2">
    {tools.map((t) => (
      <a href={t.href} class="group block rounded-2xl bg-white border border-zinc-200 p-6 hover:border-zinc-900 transition">
        <div class="flex items-start justify-between">
          <span class={`flex h-11 w-11 items-center justify-center rounded-xl ${t.chip}`}>
            <Icon name={t.icon} class="h-6 w-6" />
          </span>
          <Icon name="arrow-right" class="h-4 w-4 mt-1 text-zinc-300 group-hover:text-zinc-900 transition" />
        </div>
        <h2 class="mt-4 font-bold text-lg">{t.title}</h2>
        <p class="mt-1 text-sm text-zinc-600">{t.desc}</p>
      </a>
    ))}

  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Remove Line Breaks — Strip Newlines from Text Online, Free"
  description="Paste text to remove all line breaks, delete extra blank lines, or replace newlines with spaces — instantly and free. Nothing is uploaded; everything runs in your browser."
>
  <div class="flex items-center gap-3">
    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
      <Icon name="wrap-text" class="h-6 w-6" />
    </span>
    <h1 class="text-3xl font-extrabold tracking-tight">Remove Line Breaks</h1>
  </div>
  <p class="mt-3 text-zinc-600 leading-relaxed">
    Paste text to remove all line breaks, delete extra blank lines, or replace newlines with
    spaces — instantly and free. Nothing is uploaded; everything runs in your browser.
    Ideal for cleaning up PDF copy-pastes and email forwards.
  </p>

  <div class="mt-6">
    <textarea
      id="input"
      rows="8"
      placeholder="Paste messy text here…"
      class="w-full rounded-xl border border-zinc-300 p-4 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white"></textarea>

    <div class="mt-3 flex flex-wrap gap-2">
      <button data-mode="all" class="rounded-lg bg-zinc-900 px-3 py-2 text-sm font-medium text-white hover:bg-zinc-700">Remove all line breaks</button>
      <button data-mode="blank" class="rounded-lg bg-zinc-900 px-3 py-2 text-sm font-medium text-white hover:bg-zinc-700">Remove blank lines only</button>
      <button data-mode="trim" class="rounded-lg bg-white border border-zinc-300 px-3 py-2 text-sm font-medium text-zinc-800 hover:border-zinc-900">Trim spaces on each line</button>
      <button id="copy" class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-300 px-3 py-2 text-sm font-medium text-zinc-800 hover:border-zinc-900 bg-white"><Icon name="copy" class="h-4 w-4" /><span>Copy result</span></button>
    </div>

    <textarea
      id="output"
      rows="8"
      readonly
      placeholder="Clean text appears here…"
      class="mt-4 w-full rounded-xl border border-zinc-300 p-4 font-mono text-sm bg-zinc-100"></textarea>
  </div>

  <section class="mt-10">
    <h2 class="text-xl font-bold">FAQ</h2>
    <div class="mt-3 space-y-4 text-zinc-800">
      <div>
        <h3 class="font-semibold">Why does text copied from a PDF have weird line breaks?</h3>
        <p class="text-sm text-zinc-600">PDFs store visual line positions, not logical paragraphs. Copying preserves every visual break — "Remove all line breaks" turns it back into flowing text.</p>
      </div>
      <div>
        <h3 class="font-semibold">Will removing line breaks merge my paragraphs?</h3>
        <p class="text-sm text-zinc-600">Yes — "Remove all" merges everything into one block. Keep paragraph structure by choosing "Remove blank lines only" instead.</p>
      </div>
    </div>
  </section>

  <p class="mt-8 text-sm text-zinc-500">
    Also try: <a href="/text-sorter" class="text-emerald-700 underline">text sorter</a> or
    <a href="/word-counter" class="text-emerald-700 underline">word counter</a>.
  </p>
</BaseLayout>

<script>
  const input = document.getElementById('input') as HTMLTextAreaElement;
  const output = document.getElementById('output') as HTMLTextAreaElement;

  const modes: Record<string, (s: string) => string> = {
    all: (s) =>
      s
        .replace(/\r?\n+/g, ' ')
        .replace(/[ \t]{2,}/g, ' ')
        .trim(),
    blank: (s) => s.replace(/\r?\n[ \t]*(?=\r?\n)+/g, '\n').replace(/^\s+|\s+$/g, ''),
    trim: (s) =>
      s
        .split(/\r?\n/)
        .map((l) => l.trim())
        .join('\n'),
  };

  document.querySelectorAll<HTMLButtonElement>('button[data-mode]').forEach((btn) => {
    btn.addEventListener('click', () => {
      output.value = modes[btn.dataset.mode!](input.value);
    });
  });

  document.getElementById('copy')!.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    await navigator.clipboard.writeText(output.value);
    const label = btn.querySelector('span')!;
    label.textContent = 'Copied!';
    setTimeout(() => (label.textContent = 'Copy result'), 1200);
  });
</script>

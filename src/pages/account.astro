---
// 账户页：服务端渲染（读会话 Cookie 判断登录与订阅状态）
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRuntimeEnv } from '../lib/store';
import { getSessionUser, getSubscription } from '../lib/auth';

export const prerender = false;

const { locals, cookies } = Astro;
const env = getRuntimeEnv(locals);
const user = await getSessionUser(env, cookies.get('tk_session')?.value);
const sub = user ? await getSubscription(env, user.userId) : null;
---

<BaseLayout
  title="Account — TextKit AI"
  description="Manage your TextKit AI account and subscription."
>
  {!user ? (
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight">Sign in</h1>
      <p class="mt-3 text-zinc-600 max-w-md leading-relaxed">
        Enter your email and we'll send you a one-click sign-in link. No password to remember.
      </p>
      <div class="mt-6 max-w-md">
        <div class="flex gap-2">
          <input id="email" type="email" placeholder="you@example.com" class="w-full rounded-lg border border-zinc-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white" />
          <button id="send" class="shrink-0 rounded-lg bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-zinc-700">Send link</button>
        </div>
        <p id="msg" class="mt-2 hidden text-sm text-zinc-600"></p>
      </div>
    </div>
  ) : (
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-extrabold tracking-tight">Account</h1>
        {user.plan === 'pro' ? (
          <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-sm font-semibold text-emerald-700">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M20 6 9 17l-5-5"/></svg>
            Pro
          </span>
        ) : (
          <span class="rounded-full bg-zinc-100 px-3 py-1 text-sm font-medium text-zinc-500">Free</span>
        )}
      </div>
      <p class="mt-3 text-zinc-600">Signed in as <strong>{user.email}</strong></p>

      {user.plan === 'pro' ? (
        <div class="mt-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-5">
          <h2 class="font-bold text-emerald-800">Pro is active 🎉</h2>
          <p class="mt-1 text-sm text-emerald-700">Unlimited checks & rewrites, up to 30,000 words per run.</p>
          {sub && (
            <p class="mt-2 text-xs text-emerald-600">
              {sub.plan} plan · via {sub.provider}
            </p>
          )}
          <button id="cancel" class="mt-3 text-sm text-emerald-700 underline">Cancel subscription (dev)</button>
        </div>
      ) : (
        <div class="mt-6 rounded-2xl border border-zinc-200 bg-white p-5">
          <h2 class="font-bold">You're on Free</h2>
          <p class="mt-1 text-sm text-zinc-600">
            5 checks / 3 rewrites per day, 500-word limit. Pro unlocks unlimited + 30,000 words for $4.99/month.
          </p>
          <a href="/pricing" class="mt-3 inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-500">
            Upgrade to Pro
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      )}

      <button id="logout" class="mt-6 text-sm text-zinc-400 underline hover:text-zinc-600">Sign out</button>
    </div>
  )}
</BaseLayout>

<script>
  // 登录（未登录态）
  const sendBtn = document.getElementById('send');
  if (sendBtn) {
    const email = document.getElementById('email') as HTMLInputElement;
    const msg = document.getElementById('msg')!;
    sendBtn.addEventListener('click', async () => {
      if (!email.value.trim()) return;
      sendBtn.setAttribute('disabled', '');
      msg.textContent = 'Sending…';
      msg.classList.remove('hidden');
      const res = await fetch('/api/auth/magic-link', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email.value }),
      });
      const data = await res.json();
      msg.textContent = res.ok
        ? data.devMode
          ? 'Dev mode: link printed to server console.'
          : 'Check your inbox — sign-in link sent (valid 15 minutes).'
        : (data?.error?.message ?? 'Failed.');
      sendBtn.removeAttribute('disabled');
    });
  }

  // 登出
  document.getElementById('logout')?.addEventListener('click', async () => {
    document.cookie = 'tk_session=; Max-Age=0; path=/';
    location.reload();
  });

  // 取消订阅（mock/dev：直接发 canceled 回调）
  document.getElementById('cancel')?.addEventListener('click', async () => {
    const res = await fetch('/api/payments/checkout', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' }).catch(() => null);
    // 通过账户上下文无法拿到 userId（httpOnly），dev 简化：刷新后提示
    alert('Dev cancel: use the mock checkout page or wait for the MoR portal integration.');
  });
</script>

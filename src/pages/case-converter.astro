---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Case Converter — UPPER, lower, Title, camelCase & snake_case"
  description="Convert text between uppercase, lowercase, title case, sentence case, camelCase, snake_case, and kebab-case in one click. Free, instant, and fully private."
>
  <h1 class="text-3xl font-extrabold tracking-tight">Case Converter</h1>
  <p class="mt-3 text-slate-600 leading-relaxed">
    Paste your text and click a button to convert it to UPPERCASE, lowercase, Title Case,
    Sentence case, camelCase, snake_case, or kebab-case. Free and instant — conversion runs
    entirely in your browser, so nothing is uploaded.
  </p>

  <div class="mt-6">
    <textarea
      id="input"
      rows="8"
      placeholder="Paste your text here…"
      class="w-full rounded-xl border border-slate-300 p-4 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white"></textarea>

    <div class="mt-3 flex flex-wrap gap-2">
      <button data-case="upper" class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500">UPPERCASE</button>
      <button data-case="lower" class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500">lowercase</button>
      <button data-case="title" class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500">Title Case</button>
      <button data-case="sentence" class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500">Sentence case</button>
      <button data-case="camel" class="rounded-lg bg-slate-700 px-3 py-2 text-sm font-medium text-white hover:bg-slate-600">camelCase</button>
      <button data-case="snake" class="rounded-lg bg-slate-700 px-3 py-2 text-sm font-medium text-white hover:bg-slate-600">snake_case</button>
      <button data-case="kebab" class="rounded-lg bg-slate-700 px-3 py-2 text-sm font-medium text-white hover:bg-slate-600">kebab-case</button>
      <button id="copy" class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:border-indigo-400 bg-white">Copy</button>
    </div>

    <textarea
      id="output"
      rows="8"
      readonly
      placeholder="Converted text appears here…"
      class="mt-4 w-full rounded-xl border border-slate-300 p-4 font-mono text-sm bg-slate-100"></textarea>
  </div>

  <section class="mt-10">
    <h2 class="text-xl font-bold">FAQ</h2>
    <div class="mt-3 space-y-4 text-slate-700">
      <div>
        <h3 class="font-semibold">What is Title Case?</h3>
        <p class="text-sm text-slate-600">Every major word is capitalized: "The Quick Brown Fox". Commonly used for headlines and book titles.</p>
      </div>
      <div>
        <h3 class="font-semibold">When do I need snake_case or camelCase?</h3>
        <p class="text-sm text-slate-600">They are programming naming conventions: snake_case for variables in Python and databases, camelCase for JavaScript and Java identifiers.</p>
      </div>
      <div>
        <h3 class="font-semibold">Does Sentence case fix EVERY sentence?</h3>
        <p class="text-sm text-slate-600">It capitalizes the first letter after each period, question mark, or exclamation mark, and lowercases the rest. Words like "NASA" become "nasa" — check acronyms after converting.</p>
      </div>
    </div>
  </section>

  <p class="mt-8 text-sm text-slate-500">
    Also try: <a href="/word-counter" class="text-indigo-700 underline">word counter</a> or
    <a href="/text-sorter" class="text-indigo-700 underline">text sorter</a>.
  </p>
</BaseLayout>

<script>
  const input = document.getElementById('input') as HTMLTextAreaElement;
  const output = document.getElementById('output') as HTMLTextAreaElement;

  const smallWords = new Set(['a', 'an', 'and', 'as', 'at', 'but', 'by', 'for', 'in', 'nor', 'of', 'on', 'or', 'the', 'to', 'up', 'via']);

  const words = (s: string) => s.split(/[^A-Za-z0-9]+/).filter(Boolean);

  const converters: Record<string, (s: string) => string> = {
    upper: (s) => s.toUpperCase(),
    lower: (s) => s.toLowerCase(),
    title: (s) =>
      s.toLowerCase().replace(/\b[a-z]/g, (c) => c.toUpperCase()),
    sentence: (s) =>
      s.toLowerCase().replace(/(^\s*[a-z])|([.!?]\s+[a-z])/g, (m) => m.toUpperCase()),
    camel: (s) => words(s).map((w, i) => (i === 0 ? w.toLowerCase() : w[0].toUpperCase() + w.slice(1).toLowerCase())).join(''),
    snake: (s) => words(s).map((w) => w.toLowerCase()).join('_'),
    kebab: (s) => words(s).map((w) => w.toLowerCase()).join('-'),
  };

  document.querySelectorAll<HTMLButtonElement>('button[data-case]').forEach((btn) => {
    btn.addEventListener('click', () => {
      output.value = converters[btn.dataset.case!](input.value);
    });
  });

  document.getElementById('copy')!.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    await navigator.clipboard.writeText(output.value);
    const old = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(() => (btn.textContent = old), 1200);
  });
</script>

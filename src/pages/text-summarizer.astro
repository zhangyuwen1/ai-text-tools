---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Text Summarizer — Summarize Any Text Instantly, Free"
  description="Paste any article, email, or document to get a concise summary that keeps every key fact, number, and name. Free, no signup, results in seconds."
>
  <div class="flex items-center gap-3">
    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-sky-50 text-sky-600">
      <Icon name="file-text" class="h-6 w-6" />
    </span>
    <h1 class="text-3xl font-extrabold tracking-tight">Text Summarizer</h1>
  </div>
  <p class="mt-3 text-zinc-600 leading-relaxed">
    Paste any article, email, or report and get a concise summary that keeps every key fact,
    number, and name. Free, no signup — results in seconds.
  </p>

  <div class="mt-6">
    <textarea
      id="input"
      rows="10"
      placeholder="Paste at least 50 words of text…"
      class="w-full rounded-xl border border-zinc-300 p-4 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white"></textarea>

    <div class="mt-3 flex flex-wrap items-center gap-3">
      <button id="go" class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-zinc-700">
        <Icon name="file-text" class="h-4 w-4" /><span>Summarize</span>
      </button>
      <span id="wordcount" class="text-sm text-zinc-500">0 words</span>
      <span id="quota" class="ml-auto text-sm text-zinc-500"></span>
    </div>
    <p id="error" class="mt-2 hidden text-sm text-rose-600"></p>

    <div id="resultbox" class="mt-4 hidden rounded-2xl border border-zinc-200 bg-white p-4">
      <div class="mb-2 flex items-center justify-between">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Summary</h2>
        <button id="copy" class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-300 px-2.5 py-1.5 text-xs font-medium text-zinc-800 hover:border-zinc-900 bg-white">
          <Icon name="copy" class="h-3.5 w-3.5" /><span>Copy</span>
        </button>
      </div>
      <div id="out" class="font-mono text-sm whitespace-pre-wrap"></div>
    </div>
  </div>

  <section class="mt-10">
    <h2 class="text-xl font-bold">FAQ</h2>
    <div class="mt-3 space-y-4 text-zinc-800">
      <div>
        <h3 class="font-semibold">How long is the summary?</h3>
        <p class="text-sm text-zinc-600">Roughly one third of the original length — long enough to keep the substance, short enough to save you time.</p>
      </div>
      <div>
        <h3 class="font-semibold">Does it keep numbers and names?</h3>
        <p class="text-sm text-zinc-600">Yes. The summarizer is instructed to preserve every fact, number, and name — it condenses wording, not information.</p>
      </div>
      <div>
        <h3 class="font-semibold">What can I summarize?</h3>
        <p class="text-sm text-zinc-600">Articles, emails, reports, meeting notes, papers — any English text up to 2,000 words per run.</p>
      </div>
    </div>
  </section>

  <p class="mt-8 text-sm text-zinc-500">
    Also try the <a href="/paraphrasing-tool" class="text-emerald-700 underline">paraphrasing tool</a> or
    <a href="/ai-detector" class="text-emerald-700 underline">AI detector</a>.
  </p>
</BaseLayout>

<script>
  const input = document.getElementById('input') as HTMLTextAreaElement;
  const goBtn = document.getElementById('go')!;
  const wordcount = document.getElementById('wordcount')!;
  const quota = document.getElementById('quota')!;
  const errorEl = document.getElementById('error')!;

  function updateCount() {
    const n = input.value.trim() ? input.value.trim().split(/\s+/).length : 0;
    wordcount.textContent = `${n} words${n > 0 && n < 50 ? ` (${50 - n} more needed)` : n > 2000 ? ' (over 2000-word limit)' : ''}`;
  }
  input.addEventListener('input', updateCount);
  updateCount();

  goBtn.addEventListener('click', async () => {
    errorEl.classList.add('hidden');
    const label = goBtn.querySelector('span')!;
    const old = label.textContent;
    label.textContent = 'Summarizing…';
    goBtn.setAttribute('disabled', '');
    try {
      const res = await fetch('/api/summarize', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: input.value }),
      });
      const data = await res.json();
      if (!res.ok) {
        errorEl.textContent = data?.error?.message ?? 'Something went wrong.';
        errorEl.classList.remove('hidden');
        return;
      }
      document.getElementById('out')!.textContent = data.result;
      quota.textContent = `${data.remaining} of 5 free summaries left today`;
      document.getElementById('resultbox')!.classList.remove('hidden');
    } catch {
      errorEl.textContent = 'Network error — please try again.';
      errorEl.classList.remove('hidden');
    } finally {
      label.textContent = old;
      goBtn.removeAttribute('disabled');
    }
  });

  document.getElementById('copy')!.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    await navigator.clipboard.writeText(document.getElementById('out')!.textContent ?? '');
    const label = btn.querySelector('span')!;
    label.textContent = 'Copied!';
    setTimeout(() => (label.textContent = 'Copy'), 1200);
  });
</script>

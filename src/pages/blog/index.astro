---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogArticles } from '../../data/blog';
---

<BaseLayout
  title="Blog — TextKit AI"
  description="Guides and tutorials on AI detection, humanizing AI text, and free text tools for writers, editors, students, and SEO professionals."
>
  <h1 class="text-3xl font-extrabold tracking-tight">Blog</h1>
  <p class="mt-2 text-zinc-600">Guides on AI detection, humanizing text, and writing tools.</p>

  <div class="mt-8 space-y-6">
    {blogArticles.map((article) => (
      <article class="rounded-2xl border border-zinc-200 bg-white p-6 hover:border-zinc-900 transition">
        <div class="flex items-center gap-2 text-xs text-zinc-400">
          <time>{new Date(article.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
        </div>
        <h2 class="mt-2 text-xl font-bold">
          <a href={`/blog/${article.slug}`} class="hover:text-emerald-700">{article.title}</a>
        </h2>
        <p class="mt-1 text-sm text-zinc-600 leading-relaxed">{article.description}</p>
      </article>
    ))}
  </div>
</BaseLayout>

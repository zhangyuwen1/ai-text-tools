---
// 博客文章动态路由：/blog/<slug>
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogArticles } from '../../data/blog';

export function getStaticPaths() {
  return blogArticles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  datePublished: article.date,
  author: { '@type': 'Organization', name: 'TextKit AI' },
  publisher: { '@type': 'Organization', name: 'TextKit AI' },
  mainEntityOfPage: `https://textkitai.com/blog/${article.slug}`,
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<BaseLayout title={`${article.title} — TextKit AI`} description={article.description}>
  <article class="max-w-2xl">
    <div class="flex items-center gap-2 text-sm text-zinc-400">
      <time datetime={article.date}>{new Date(article.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      <span>·</span>
      <span>TextKit AI</span>
    </div>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight leading-tight">{article.title}</h1>
    <p class="mt-3 text-zinc-600 leading-relaxed">{article.description}</p>

    <div class="mt-8 space-y-8">
      {article.sections.map((section) => (
        <section>
          <h2 class="text-xl font-bold">{section.heading}</h2>
          <div class="mt-3 space-y-3 text-zinc-700 leading-relaxed [&_a]:text-emerald-700 [&_a]:underline [&_strong]:font-semibold [&_p]:text-[15px]">
            {section.body.split('\n\n').map((para) => (
              <p set:html={para.replace(/\n/g, '<br />')} />
            ))}
          </div>
        </section>
      ))}
    </div>

    <div class="mt-12 rounded-2xl border border-zinc-200 bg-white p-6 text-center">
      <p class="text-sm text-zinc-500">Try the tools mentioned in this article</p>
      <div class="mt-3 flex flex-wrap justify-center gap-2">
        <a href="/ai-detector" class="rounded-lg bg-zinc-900 px-3 py-2 text-sm font-semibold text-white hover:bg-zinc-700">AI Detector</a>
        <a href="/ai-humanizer" class="rounded-lg bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-500">AI Humanizer</a>
        <a href="/word-counter" class="rounded-lg border border-zinc-300 px-3 py-2 text-sm font-medium text-zinc-800 hover:border-zinc-900 bg-white">Word Counter</a>
      </div>
    </div>

    <nav class="mt-8 flex justify-between text-sm">
      <a href="/blog" class="text-emerald-700 underline">← All articles</a>
      <a href="/" class="text-emerald-700 underline">TextKit AI</a>
    </nav>
  </article>
</BaseLayout>

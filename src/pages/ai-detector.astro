---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="AI Detector — Check If Text Was Written by AI, Free"
  description="Paste text or drop multiple files to see how likely they were written by AI. Free, no signup, sentence-by-sentence highlighting and batch file scanning — files never leave your browser."
>
  <div class="flex items-center gap-3">
    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-rose-50 text-rose-600">
      <Icon name="scan" class="h-6 w-6" />
    </span>
    <h1 class="text-3xl font-extrabold tracking-tight">AI Detector</h1>
  </div>
  <p class="mt-3 text-zinc-600 leading-relaxed">
    Paste any text below to see how likely it was written by AI. Free, no signup, with
    sentence-by-sentence highlighting and a shareable report. Scores are a probability
    estimate, not proof — use them as one signal, not a verdict.
  </p>

  <!-- 模式切换 -->
  <div class="mt-6 flex gap-1.5">
    <button id="tab-paste" class="tab rounded-lg border border-zinc-900 bg-zinc-900 px-4 py-2 text-sm font-semibold text-white">Paste text</button>
    <button id="tab-batch" class="tab rounded-lg border border-zinc-300 bg-white px-4 py-2 text-sm font-semibold text-zinc-800 hover:border-zinc-900">Batch files</button>
  </div>

  <!-- ============ 面板 1：粘贴文本 ============ -->
  <div id="panel-paste" class="mt-4">
    <textarea
      id="input"
      rows="10"
      placeholder="Paste at least 50 words of text here…"
      class="w-full rounded-xl border border-zinc-300 p-4 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white"></textarea>

    <div class="mt-3 flex flex-wrap items-center gap-3">
      <button id="check" class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-zinc-700">
        <Icon name="scan" class="h-4 w-4" /><span>Check text</span>
      </button>
      <span id="wordcount" class="text-sm text-zinc-500">0 words</span>
      <span id="quota" class="ml-auto text-sm text-zinc-500"></span>
    </div>
    <p id="error" class="mt-2 hidden text-sm text-rose-600"></p>
  </div>

  <!-- ============ 面板 2：批量文件 ============ -->
  <div id="panel-batch" class="mt-4 hidden">
    <div
      id="dropzone"
      class="rounded-2xl border-2 border-dashed border-zinc-300 bg-white p-8 text-center cursor-pointer hover:border-zinc-900 transition">
      <Icon name="file-text" class="h-8 w-8 mx-auto text-zinc-400" />
      <p class="mt-3 font-medium">Drop .txt / .md files or a .zip here</p>
      <p class="mt-1 text-sm text-zinc-500">or click to browse — up to 50 files, 1 MB each</p>
      <input id="file-input" type="file" multiple accept=".txt,.md,.markdown,.text,.zip" class="hidden" />
    </div>
    <p class="mt-2 flex items-center gap-1.5 text-xs text-zinc-500">
      <Icon name="lock" class="h-3.5 w-3.5 text-emerald-600" /> Batch scanning runs entirely in your browser — files are never uploaded.
    </p>

    <div id="batch-bar" class="mt-4 hidden flex-wrap items-center gap-3">
      <span id="batch-count" class="text-sm font-medium"></span>
      <button id="scan-all" class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-4 py-2 text-sm font-semibold text-white hover:bg-zinc-700">
        <Icon name="scan" class="h-4 w-4" /><span>Scan all</span>
      </button>
      <button id="copy-report" class="hidden inline-flex items-center gap-1.5 rounded-lg border border-zinc-300 px-3 py-2 text-sm font-medium text-zinc-800 hover:border-zinc-900 bg-white">
        <Icon name="copy" class="h-4 w-4" /><span>Copy report</span>
      </button>
      <button id="clear-batch" class="text-sm text-zinc-500 hover:text-zinc-900 underline">Clear</button>
    </div>
    <p id="batch-error" class="mt-2 hidden text-sm text-rose-600"></p>
    <div id="batch-list" class="mt-4 space-y-2"></div>
  </div>

  <!-- 结果区（粘贴模式） -->
  <div id="result" class="mt-8 hidden">
    <div class="rounded-2xl border border-zinc-200 bg-white p-6">
      <div class="flex flex-col sm:flex-row items-center gap-6">
        <div class="relative h-32 w-32 shrink-0">
          <svg viewBox="0 0 120 120" class="h-32 w-32 -rotate-90">
            <circle cx="60" cy="60" r="52" fill="none" stroke="#e4e4e7" stroke-width="10" />
            <circle id="ring" cx="60" cy="60" r="52" fill="none" stroke="#e11d48" stroke-width="10" stroke-linecap="round" stroke-dasharray="326.7" stroke-dashoffset="326.7" />
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span id="score" class="text-3xl font-extrabold">–</span>
            <span class="text-[10px] text-zinc-500 uppercase tracking-wide">AI score</span>
          </div>
        </div>
        <div class="text-center sm:text-left">
          <h2 id="verdict" class="text-xl font-bold">–</h2>
          <p id="meta" class="mt-1 text-sm text-zinc-500"></p>
          <div class="mt-3 flex flex-wrap gap-2">
            <button id="share" class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-300 px-3 py-2 text-sm font-medium text-zinc-800 hover:border-zinc-900 bg-white">
              <Icon name="copy" class="h-4 w-4" /><span>Create share link</span>
            </button>
            <a id="cta" href="/ai-humanizer" class="hidden inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-500">
              Make it sound human <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </div>
          <a id="sharelink" href="#" target="_blank" class="mt-2 hidden text-sm text-emerald-700 underline break-all"></a>
        </div>
      </div>
    </div>

    <div class="mt-4 rounded-2xl border border-zinc-200 bg-white p-6">
      <h2 class="font-bold">Sentence breakdown</h2>
      <p class="text-xs text-zinc-500 mt-0.5">Red = likely AI · Amber = mixed · Green = likely human</p>
      <div id="sentences" class="mt-4 space-y-2 text-sm leading-relaxed"></div>
    </div>
  </div>

  <section class="mt-10">
    <h2 class="text-xl font-bold">FAQ</h2>
    <div class="mt-3 space-y-4 text-zinc-800">
      <div>
        <h3 class="font-semibold">How accurate is AI detection?</h3>
        <p class="text-sm text-zinc-600">No detector is definitive. Results are probabilistic and can misjudge formulaic human writing and lightly edited AI text. Treat the score as one signal, never as proof.</p>
      </div>
      <div>
        <h3 class="font-semibold">Can I check multiple files at once?</h3>
        <p class="text-sm text-zinc-600">Yes — switch to "Batch files" and drop any number of .txt or .md files, or a .zip containing them. Each file gets its own score. Batch scanning happens entirely in your browser, so nothing is uploaded and there's no daily limit.</p>
      </div>
      <div>
        <h3 class="font-semibold">Is my text stored?</h3>
        <p class="text-sm text-zinc-600">Detection itself stores nothing. Text is saved for 7 days only if you click "Create share link", and only you get that link. Batch files never leave your device at all.</p>
      </div>
    </div>
  </section>

  <p class="mt-8 text-sm text-zinc-500">
    Flagged as AI? Try the <a href="/ai-humanizer" class="text-emerald-700 underline">AI Humanizer</a>.
    Also see <a href="/word-counter" class="text-emerald-700 underline">word counter</a>.
  </p>
</BaseLayout>

<script>
  import { heuristicDetector, AI_MARKERS } from '../lib/detect/heuristic';
  import { unzipSync } from 'fflate';

  // ============ Tab 切换 ============
  const tabPaste = document.getElementById('tab-paste')!;
  const tabBatch = document.getElementById('tab-batch')!;
  const panelPaste = document.getElementById('panel-paste')!;
  const panelBatch = document.getElementById('panel-batch')!;

  function setTab(batch: boolean) {
    tabPaste.className = 'tab rounded-lg border ' + (batch ? 'border-zinc-300 bg-white text-zinc-800 hover:border-zinc-900' : 'border-zinc-900 bg-zinc-900 text-white') + ' px-4 py-2 text-sm font-semibold';
    tabBatch.className = 'tab rounded-lg border ' + (batch ? 'border-zinc-900 bg-zinc-900 text-white' : 'border-zinc-300 bg-white text-zinc-800 hover:border-zinc-900') + ' px-4 py-2 text-sm font-semibold';
    panelPaste.classList.toggle('hidden', batch);
    panelBatch.classList.toggle('hidden', !batch);
  }
  tabPaste.addEventListener('click', () => setTab(false));
  tabBatch.addEventListener('click', () => setTab(true));

  // ============ 粘贴文本模式（原有逻辑） ============
  const input = document.getElementById('input') as HTMLTextAreaElement;
  const checkBtn = document.getElementById('check')!;
  const wordcount = document.getElementById('wordcount')!;
  const quota = document.getElementById('quota')!;
  const errorEl = document.getElementById('error')!;
  const resultEl = document.getElementById('result')!;

  const FLAG_STYLE: Record<string, string> = {
    high: 'bg-rose-50 border-l-2 border-rose-400 text-rose-900',
    mid: 'bg-amber-50 border-l-2 border-amber-400 text-amber-900',
    low: 'bg-emerald-50 border-l-2 border-emerald-400 text-emerald-900',
  };

  const VERDICTS: Record<string, { text: string; cls: string }> = {
    ai: { text: 'Likely AI-generated', cls: 'text-rose-600' },
    mixed: { text: 'Mixed signals', cls: 'text-amber-600' },
    human: { text: 'Likely human-written', cls: 'text-emerald-600' },
  };

  function updateCount() {
    const n = input.value.trim() ? input.value.trim().split(/\s+/).length : 0;
    wordcount.textContent = `${n} words${n > 0 && n < 50 ? ` (${50 - n} more needed)` : ''}`;
  }
  input.addEventListener('input', updateCount);

  // 闭环：从 humanizer 跳转预填（/ai-detector?text=...）
  const prefill = new URLSearchParams(location.search).get('text');
  if (prefill) input.value = prefill;
  updateCount();

  checkBtn.addEventListener('click', async () => {
    errorEl.classList.add('hidden');
    const label = checkBtn.querySelector('span')!;
    const old = label.textContent;
    label.textContent = 'Checking…';
    checkBtn.setAttribute('disabled', '');

    try {
      const res = await fetch('/api/detect', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: input.value }),
      });
      const data = await res.json();

      if (!res.ok) {
        errorEl.textContent = data?.error?.message ?? 'Something went wrong.';
        errorEl.classList.remove('hidden');
        return;
      }
      render(data);
    } catch {
      errorEl.textContent = 'Network error — please try again.';
      errorEl.classList.remove('hidden');
    } finally {
      label.textContent = old;
      checkBtn.removeAttribute('disabled');
    }
  });

  interface Sent { offset: number; len: number; flag: string }
  let lastSentences: { text: string; flag: string }[] = [];
  let lastScore = 0;

  function render(data: { score: number; label: string; words: number; sentences: Sent[]; remaining: number }) {
    lastScore = data.score;
    lastSentences = data.sentences.map((s) => ({
      text: input.value.slice(s.offset, s.offset + s.len).trim(),
      flag: s.flag,
    }));

    const ring = document.getElementById('ring')!;
    const circumference = 2 * Math.PI * 52;
    ring.style.strokeDashoffset = String(circumference * (1 - data.score));
    ring.setAttribute('stroke', data.score > 0.7 ? '#e11d48' : data.score >= 0.4 ? '#d97706' : '#059669');
    document.getElementById('score')!.textContent = `${Math.round(data.score * 100)}%`;

    const v = VERDICTS[data.label];
    const verdict = document.getElementById('verdict')!;
    verdict.textContent = v.text;
    verdict.className = `text-xl font-bold ${v.cls}`;
    document.getElementById('meta')!.textContent = `${data.words} words · ${data.sentences.length} sentences`;
    quota.textContent = `${data.remaining} of 5 free checks left today`;

    document.getElementById('sentences')!.innerHTML = lastSentences
      .map((s) => `<p class="rounded-r-lg px-3 py-2 ${FLAG_STYLE[s.flag] ?? ''}">${escapeHtml(s.text)}</p>`)
      .join('');

    document.getElementById('cta')!.classList.toggle('hidden', data.score <= 0.7);
    document.getElementById('sharelink')!.classList.add('hidden');

    resultEl.classList.remove('hidden');
    resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.getElementById('share')!.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const label = btn.querySelector('span')!;
    const old = label.textContent;
    label.textContent = 'Creating…';
    try {
      const res = await fetch('/api/share', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: input.value, score: lastScore, sentences: lastSentences }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error?.message);
      const link = document.getElementById('sharelink')! as HTMLAnchorElement;
      link.href = data.url;
      link.textContent = `${location.origin}${data.url}`;
      link.classList.remove('hidden');
      await navigator.clipboard.writeText(`${location.origin}${data.url}`).catch(() => {});
      label.textContent = 'Copied!';
      setTimeout(() => (label.textContent = old), 1500);
    } catch {
      label.textContent = 'Failed';
      setTimeout(() => (label.textContent = old), 1500);
    }
  });

  // ============ 批量文件模式（纯浏览器端） ============
  const MAX_FILES = 50;
  const MAX_FILE_BYTES = 1024 * 1024;
  const TEXT_EXT = /\.(txt|md|markdown|text)$/i;

  const dropzone = document.getElementById('dropzone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const batchBar = document.getElementById('batch-bar')!;
  const batchCount = document.getElementById('batch-count')!;
  const batchError = document.getElementById('batch-error')!;
  const batchList = document.getElementById('batch-list')!;
  const scanAllBtn = document.getElementById('scan-all')!;
  const copyReportBtn = document.getElementById('copy-report')!;
  const clearBtn = document.getElementById('clear-batch')!;

  interface BatchFile {
    name: string;
    text: string;
    words: number;
    score?: number;
    label?: string;
    tooShort?: boolean;
    detail?: { high: number; mid: number; low: number; markers: string[] };
    sentences?: { text: string; flag: string }[];
  }

  let batchFiles: BatchFile[] = [];

  dropzone.addEventListener('click', () => fileInput.click());
  dropzone.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('border-zinc-900'); });
  dropzone.addEventListener('dragleave', () => dropzone.classList.remove('border-zinc-900'));
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-zinc-900');
    handleFiles(e.dataTransfer?.files);
  });
  fileInput.addEventListener('change', () => handleFiles(fileInput.files));

  async function handleFiles(files: FileList | null | undefined) {
    batchError.classList.add('hidden');
    if (!files?.length) return;
    const incoming = Array.from(files);

    for (const f of incoming) {
      if (batchFiles.length >= MAX_FILES) {
        showBatchError(`Limit reached — max ${MAX_FILES} files.`);
        break;
      }
      if (f.size > MAX_FILE_BYTES) {
        showBatchError(`"${f.name}" skipped — larger than 1 MB.`);
        continue;
      }
      if (f.name.toLowerCase().endsWith('.zip')) {
        try {
          const entries = unzipSync(new Uint8Array(await f.arrayBuffer()));
          const decoder = new TextDecoder();
          for (const [name, bytes] of Object.entries(entries)) {
            if (name.startsWith('__MACOSX') || name.includes('/.') || !TEXT_EXT.test(name)) continue;
            const text = decoder.decode(bytes).trim();
            if (!text) continue;
            if (batchFiles.length >= MAX_FILES) break;
            batchFiles.push(makeFile(name.split('/').pop() ?? name, text));
          }
        } catch {
          showBatchError(`"${f.name}" could not be unzipped.`);
        }
      } else if (TEXT_EXT.test(f.name)) {
        const text = (await f.text()).trim();
        if (text) batchFiles.push(makeFile(f.name, text));
      } else {
        showBatchError(`"${f.name}" skipped — only .txt / .md / .zip supported.`);
      }
    }

    fileInput.value = '';
    renderBatchList();
  }

  function makeFile(name: string, text: string): BatchFile {
    const words = text.split(/\s+/).length;
    return { name, text, words, tooShort: words < 50 };
  }

  function showBatchError(msg: string) {
    batchError.textContent = msg;
    batchError.classList.remove('hidden');
  }

  function renderBatchList() {
    batchBar.classList.remove('hidden');
    batchBar.classList.add('flex');
    batchCount.textContent = `${batchFiles.length} file${batchFiles.length === 1 ? '' : 's'} loaded`;

    batchList.innerHTML = batchFiles
      .map((f, i) => {
        const scoreCell = f.tooShort
          ? '<span class="text-xs text-zinc-400">too short</span>'
          : f.score === undefined
            ? '<span class="text-xs text-zinc-400">—</span>'
            : scoreBadge(f.score, f.label!);
        return `
        <div class="rounded-xl border border-zinc-200 bg-white px-4 py-2.5" data-batch-row="${i}">
          <div class="flex cursor-pointer items-center justify-between gap-3" onclick="this.parentElement.querySelector('.bd-${i}').classList.toggle('hidden')">
            <div class="flex min-w-0 items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0 text-zinc-400"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
              <span class="truncate text-sm font-medium">${escapeHtml(f.name)}</span>
              <span class="shrink-0 text-xs text-zinc-400">${f.words} words</span>
            </div>
            <div class="shrink-0" id="bf-${i}">${scoreCell}</div>
          </div>
          <div class="bd-${i} hidden mt-2 border-t border-zinc-100 pt-2 text-xs text-zinc-500"></div>
        </div>`;
      })
      .join('');
  }

  function scoreBadge(score: number, label: string): string {
    const pct = Math.round(score * 100);
    const tone =
      label === 'ai'
        ? 'bg-rose-50 text-rose-700'
        : label === 'mixed'
          ? 'bg-amber-50 text-amber-700'
          : 'bg-emerald-50 text-emerald-700';
    const verdict = label === 'ai' ? 'Likely AI' : label === 'mixed' ? 'Mixed' : 'Likely human';
    return `<span class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold ${tone}">${pct}% · ${verdict}</span>`;
  }

  scanAllBtn.addEventListener('click', async () => {
    const label = scanAllBtn.querySelector('span')!;
    const old = label.textContent;
    label.textContent = 'Scanning…';
    scanAllBtn.setAttribute('disabled', '');

    const t0 = performance.now();
    let aiCount = 0;
    let scored = 0;
    for (let i = 0; i < batchFiles.length; i++) {
      const f = batchFiles[i];
      if (!f.tooShort) {
        const r = await heuristicDetector.detect(f.text);
        f.score = r.score;
        f.label = r.score > 0.7 ? 'ai' : r.score >= 0.4 ? 'mixed' : 'human';
        if (f.label === 'ai') aiCount++;
        scored++;

        // 评分依据：句子分布 + 命中的 AI 高频词 + 逐句明细（供详情展开）
        const counts = { high: 0, mid: 0, low: 0 };
        for (const s of r.sentences) counts[s.flag]++;
        const lower = f.text.toLowerCase();
        const markerHits: [string, number][] = [];
        for (const m of AI_MARKERS) {
          const n = lower.split(m).length - 1;
          if (n > 0) markerHits.push([m, n]);
        }
        markerHits.sort((a, b) => b[1] - a[1]);
        f.detail = { ...counts, markers: markerHits.slice(0, 5).map(([m, n]) => (n > 1 ? `${m} ×${n}` : m)) };
        f.sentences = r.sentences.map((s) => ({ text: f.text.slice(s.offset, s.offset + s.len).trim(), flag: s.flag }));

        // 逐个渲染，让进度可见
        const cell = document.getElementById(`bf-${i}`);
        if (cell) cell.innerHTML = scoreBadge(f.score, f.label);
        const detailEl = document.querySelector(`.bd-${i}`);
        if (detailEl && f.detail) {
          const evidence =
            `${r.sentences.length} sentences · ${f.detail.high} high / ${f.detail.mid} mid / ${f.detail.low} low` +
            (f.detail.markers.length ? ` · AI words: ${f.detail.markers.join(', ')}` : ' · no AI marker words');
          const sentList = (f.sentences ?? [])
            .map((s) => `<p class="rounded-r-lg px-2.5 py-1.5 leading-relaxed ${FLAG_STYLE[s.flag] ?? ''}">${escapeHtml(s.text)}</p>`)
            .join('');
          detailEl.innerHTML = `
            <p class="mb-2">${evidence}</p>
            <div class="max-h-64 space-y-1.5 overflow-y-auto pr-1 text-xs">${sentList}</div>
            <div class="mt-2 flex flex-wrap items-center gap-2">
              <button data-share="${i}" class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-300 px-2.5 py-1.5 text-xs font-medium text-zinc-800 hover:border-zinc-900 bg-white">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" x2="12" y1="2" y2="15"/></svg>
                <span>Create share link</span>
              </button>
              <a data-sharelink="${i}" href="#" target="_blank" class="hidden break-all text-emerald-700 underline"></a>
            </div>`;
        }
        await new Promise((r2) => setTimeout(r2, 10)); // 让 UI 呼吸
      }
    }
    const elapsed = Math.max(1, Math.round(performance.now() - t0));

    batchCount.textContent = `${batchFiles.length} files · ${scored} scored · ${aiCount} likely AI · ${elapsed} ms (scanned locally)`;
    copyReportBtn.classList.remove('hidden');
    label.textContent = old;
    scanAllBtn.removeAttribute('disabled');
  });

  // 批量文件分享（委托：详情面板内的 share 按钮）
  batchList.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('[data-share]') as HTMLButtonElement | null;
    if (!btn) return;
    e.stopPropagation();
    const i = Number(btn.dataset.share);
    const f = batchFiles[i];
    if (!f?.score || !f.sentences) return;

    const label = btn.querySelector('span')!;
    const old = label.textContent;
    label.textContent = 'Creating…';
    btn.setAttribute('disabled', '');
    try {
      const res = await fetch('/api/share', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: f.text, score: f.score, sentences: f.sentences }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error?.message);
      const link = document.querySelector(`[data-sharelink="${i}"]`) as HTMLAnchorElement;
      link.href = data.url;
      link.textContent = `${location.origin}${data.url}`;
      link.classList.remove('hidden');
      await navigator.clipboard.writeText(`${location.origin}${data.url}`).catch(() => {});
      label.textContent = 'Copied!';
      setTimeout(() => (label.textContent = old), 1500);
    } catch {
      label.textContent = 'Failed';
      setTimeout(() => (label.textContent = old), 1500);
    } finally {
      btn.removeAttribute('disabled');
    }
  });

  copyReportBtn.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const lines = batchFiles.map((f) =>
      f.tooShort
        ? `${f.name} — too short`
        : `${f.name} — ${Math.round((f.score ?? 0) * 100)}% (${f.label === 'ai' ? 'Likely AI' : f.label === 'mixed' ? 'Mixed' : 'Likely human'})`,
    );
    const report = `AI Batch Report — ${new Date().toISOString().slice(0, 10)}\n${lines.join('\n')}`;
    await navigator.clipboard.writeText(report);
    const label = btn.querySelector('span')!;
    label.textContent = 'Copied!';
    setTimeout(() => (label.textContent = 'Copy report'), 1500);
  });

  clearBtn.addEventListener('click', () => {
    batchFiles = [];
    batchList.innerHTML = '';
    batchBar.classList.add('hidden');
    copyReportBtn.classList.add('hidden');
    batchError.classList.add('hidden');
  });

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
</script>
